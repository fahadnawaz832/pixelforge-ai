# Pluggable AI provider for background removal & CV suit transformation.
# Implement lib/providers/aiProvider.ts to call whichever vendor you choose
# (e.g. remove.bg, Replicate, OpenAI images, Stability). Never call AI for
# plain conversion/resize/crop/compress — Sharp handles that locally.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MIN=20
